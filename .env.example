# This example is for run aergo node and scan in a single host
# Please refer to this file and create your own .env file.
# Set true if Aergoscan itself supports TLS layer directly.
USE_DNS=false

# gRPC endpoint of the Aergo node. Used as the upstream target for the node proxy and indexer.
AERGO_NODE=localhost:7845

# Public host URLs served by the embedded nginx.
# nginx uses these values as virtual host names for TLS termination and routing.
AERGO_NODE_HOST=https://aergo-rpc-http.privhost.io
SCAN_API_HOST=https://scan-api.privhost.io
SCAN_EXPLORER_HOST=http://scan.privhost.io